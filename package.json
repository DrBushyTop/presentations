{
  "name": "zure-slidev-presentations",
  "type": "module",
  "private": true,
  "version": "1.0.0",
  "description": "Reusable Zure Slidev themes and presentations",
  "scripts": {
    "dev": "node scripts/select-deck.mjs dev",
    "start": "node scripts/select-deck.mjs start",
    "dev:coding-agents": "cd coding-agents && slidev slides.md --remote=slides --bind 0.0.0.0 --open",
    "start:coding-agents": "cd coding-agents && slidev slides.md --remote=slides --bind 0.0.0.0",
    "dev:database-modernization": "cd database-modernization && slidev slides.md --remote=slides --bind 0.0.0.0 --open",
    "start:database-modernization": "cd database-modernization && slidev slides.md --remote=slides --bind 0.0.0.0",
    "dev:agent-building-blocks": "cd agent-building-blocks && slidev slides.md --remote=slides --bind 0.0.0.0 --open",
    "start:agent-building-blocks": "cd agent-building-blocks && slidev slides.md --remote=slides --bind 0.0.0.0",
    "dev:workshop-intro": "cd workshop-intro && slidev slides.md --remote=slides --bind 0.0.0.0 --open",
    "start:workshop-intro": "cd workshop-intro && slidev slides.md --remote=slides --bind 0.0.0.0",
    "dev:no-slop": "cd no-slop-deck && slidev slides.md --remote=slides --bind 0.0.0.0 --open",
    "start:no-slop": "cd no-slop-deck && slidev slides.md --remote=slides --bind 0.0.0.0 --port 3131",
    "dev:hill-climb": "node scripts/hill-climb-sounds.mjs && cd hill-climb && slidev slides.md --remote=slides --bind 0.0.0.0 --open",
    "start:hill-climb": "node scripts/hill-climb-sounds.mjs && cd hill-climb && slidev slides.md --remote=slides --bind 0.0.0.0 --port 3232",
    "dev:sample:aks-aca-workshop": "cd coding-agents/samples && slidev aks-aca-workshop.md --open",
    "build": "npm run build:all",
    "build:all": "npm run build:coding-agents && npm run build:database-modernization && npm run build:agent-building-blocks && npm run build:workshop-intro && npm run build:no-slop && npm run build:hill-climb",
    "build:coding-agents": "cd coding-agents && slidev build slides.md --out ../dist/coding-agents",
    "build:database-modernization": "cd database-modernization && slidev build slides.md --out ../dist/database-modernization",
    "build:agent-building-blocks": "cd agent-building-blocks && slidev build slides.md --out ../dist/agent-building-blocks",
    "build:workshop-intro": "cd workshop-intro && slidev build slides.md --out ../dist/workshop-intro",
    "build:no-slop": "cd no-slop-deck && slidev build slides.md --out ../dist/no-slop-clicks",
    "sounds:hill-climb": "node scripts/hill-climb-sounds.mjs",
    "build:hill-climb": "cd hill-climb && slidev build slides.md --out ../dist/hill-climb",
    "export": "node scripts/select-deck.mjs export",
    "export-pptx": "node scripts/select-deck.mjs export-pptx",
    "live": "node scripts/live.mjs start",
    "live:deploy": "node scripts/live.mjs deploy",
    "live:stop": "node scripts/live.mjs stop",
    "live:url": "node scripts/live.mjs url",
    "live:setup": "node scripts/live.mjs setup",
    "live:login": "node scripts/live.mjs login",
    "live:relay": "node scripts/live.mjs relay",
    "live:screen-setup": "node scripts/live.mjs screen-setup",
    "live:latency": "node scripts/live-latency.mjs",
    "export:coding-agents": "cd coding-agents && slidev export slides.md",
    "export:database-modernization": "cd database-modernization && slidev export slides.md",
    "export:agent-building-blocks": "cd agent-building-blocks && slidev export slides.md",
    "export:workshop-intro": "cd workshop-intro && slidev export slides.md",
    "export:no-slop": "cd no-slop-deck && slidev export slides.md",
    "export:hill-climb": "cd hill-climb && slidev export slides.md",
    "export-pptx:coding-agents": "cd coding-agents && slidev export slides.md --format pptx",
    "export-pptx:database-modernization": "cd database-modernization && slidev export slides.md --format pptx",
    "export-pptx:agent-building-blocks": "cd agent-building-blocks && slidev export slides.md --format pptx",
    "export-pptx:workshop-intro": "cd workshop-intro && slidev export slides.md --format pptx",
    "export-pptx:no-slop": "cd no-slop-deck && slidev export slides.md --format pptx",
    "export-pptx:hill-climb": "cd hill-climb && slidev export slides.md --format pptx",
    "demo:install": "npm --prefix no-slop-deck/demo-app ci",
    "demo:dev": "npm --prefix no-slop-deck/demo-app run dev",
    "demo:check": "npm --prefix no-slop-deck/demo-app run check",
    "demo:start": "npm --prefix no-slop-deck/demo-app run build && npm --prefix no-slop-deck/demo-app start",
    "demo:reset": "npm --prefix no-slop-deck/demo-app run reset",
    "prepare": "git config core.hooksPath .githooks",
    "check:slides": "node scripts/check-slides.mjs",
    "check:slides:baseline": "node scripts/check-slides.mjs --update-baseline",
    "test:rehearsal": "node --test addons/rehearsal/timing.test.mjs"
  },
  "devDependencies": {
    "@slidev/cli": "^53.1.0",
    "@slidev/theme-default": "^0.25.0",
    "motion-v": "^2.11.1",
    "playwright-chromium": "^1.50.0"
  },
  "workspaces": [
    "themes/*",
    "addons/*"
  ],
  "overrides": {
    "dompurify": "^3.4.17",
    "image-size": "^2.1.0"
  }
}
